# Supabase
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Stripe
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key

# Admin
VITE_ADMIN_PASSWORD=your_secure_admin_password

# Etsy — get your API key from developers.etsy.com
# Shop ID: view source on your Etsy shop page and search for "shop_id"
VITE_ETSY_API_KEY=your_etsy_keystring
VITE_ETSY_SHOP_ID=your_numeric_shop_id

# Instagram — long-lived token from Meta for Developers (expires every 60 days, refresh via Graph API)
VITE_INSTAGRAM_TOKEN=your_instagram_long_lived_token
