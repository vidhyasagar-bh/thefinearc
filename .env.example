# Supabase
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Stripe — the publishable key is public (VITE_ prefix); the secret key and webhook secret are server-only (no VITE_)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_live_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Address suggestions at checkout (optional; without a key the street field is a plain box).
# Preferred: Google Places (New). Google Cloud Console -> enable "Places API (New)" -> create an API key.
# Public key — restrict it to your website addresses (HTTP referrers) and to the Places API (New).
VITE_GOOGLE_PLACES_KEY=your_google_places_key
# Fallback if no Google key is set: Geoapify (myprojects.geoapify.com), also restricted to your website addresses
VITE_GEOAPIFY_KEY=your_geoapify_key
# Shipping estimates (Shippo). Server-side only. Shippo key: apps.goshippo.com -> Settings -> API (use a test key first)
SHIPPO_API_KEY=shippo_test_your_key
SHIP_FROM_NAME=The Fine Arc
SHIP_FROM_STREET1=your_street_address
SHIP_FROM_CITY=your_city
SHIP_FROM_STATE=TX
SHIP_FROM_ZIP=your_zip
# Countries customers can ship to (default US only)
SHIPPING_COUNTRIES=US
# Used for any artwork without its own packing size (weight in oz, size in inches)
SHIP_DEFAULT_WEIGHT_OZ=16
SHIP_DEFAULT_LENGTH_IN=14
SHIP_DEFAULT_WIDTH_IN=14
SHIP_DEFAULT_HEIGHT_IN=2

# Email — sent from Vercel via SMTP. Gmail needs 2-step verification + an App Password
# (myaccount.google.com/apppasswords). To switch to a domain mailbox later, change only these.
SMTP_USER=thefinearc@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
# Optional: SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  EMAIL_FROM=  ARTIST_EMAIL=thefinearc@gmail.com

# Admin — server-side only (NO VITE_ prefix). Mark as Sensitive in Vercel.
ADMIN_PASSWORD=a_long_unique_admin_password
# Optional: separate secret used to sign admin sessions (changing it signs everyone out)
# ADMIN_SESSION_SECRET=a_long_random_string

# Etsy — get your API key from developers.etsy.com
# Shop ID: view source on your Etsy shop page and search for "shop_id"
VITE_ETSY_API_KEY=your_etsy_keystring
VITE_ETSY_SHOP_ID=your_numeric_shop_id

# Instagram — easiest: free Behold.so feed (no Meta developer account). Paste the JSON feed URL.
VITE_INSTAGRAM_FEED_URL=https://feeds.behold.so/your_feed_id
# Alternative: official Graph API long-lived token (expires every 60 days)
# VITE_INSTAGRAM_TOKEN=your_instagram_long_lived_token
