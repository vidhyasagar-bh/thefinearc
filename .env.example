# Supabase
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Stripe — set these in Vercel (server-side only, NEVER prefix with VITE_)
STRIPE_SECRET_KEY=sk_live_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Optional: comma-separated ISO codes customers can ship to (default US,CA,GB,AU)
SHIPPING_COUNTRIES=US,CA,GB,AU

# Email — sent from Vercel via SMTP. Gmail needs 2-step verification + an App Password
# (myaccount.google.com/apppasswords). To switch to a domain mailbox later, change only these.
SMTP_USER=thefinearc@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
# Optional: SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  EMAIL_FROM=  ARTIST_EMAIL=thefinearc@gmail.com

# Admin
VITE_ADMIN_PASSWORD=your_secure_admin_password

# Etsy — get your API key from developers.etsy.com
# Shop ID: view source on your Etsy shop page and search for "shop_id"
VITE_ETSY_API_KEY=your_etsy_keystring
VITE_ETSY_SHOP_ID=your_numeric_shop_id

# Instagram — easiest: free Behold.so feed (no Meta developer account). Paste the JSON feed URL.
VITE_INSTAGRAM_FEED_URL=https://feeds.behold.so/your_feed_id
# Alternative: official Graph API long-lived token (expires every 60 days)
# VITE_INSTAGRAM_TOKEN=your_instagram_long_lived_token
